DATABASE_URL="postgresql://lynk:lynk@localhost:5432/lynk_vpn"
REDIS_URL="redis://localhost:6379"

# Публичный https-адрес бэкенда: из него строится ссылка подписки https://.../sub/<token>
PUBLIC_URL="https://api.example.com"
SUPPORT_URL="https://t.me/lynkvpnsupportbot"

# Токен бота @lynkorobot. Можно несколько через запятую (первый: активный бот).
TELEGRAM_BOT_TOKEN=""
BOT_USERNAME="lynkorobot"
# Адрес Mini App (кнопка в боте и напоминаниях)
WEBAPP_URL="https://lumavpnbot.github.io/lumavpnhere/"
# 1 = не регистрировать вебхук бота (если ботом временно управляет другой сервис)
BOT_DISABLED=""

# Telegram ID владельцев через запятую: постоянный «Премиум» и полный доступ к /admin
ADMIN_TELEGRAM_IDS=""

# --- Почта (привязка в «Способах входа») ---
# Ключ Resend (resend.com → API Keys) и отправитель с подтверждённого домена
RESEND_API_KEY=""
EMAIL_FROM="LYNK <no-reply@ваш-домен>"

# --- Платежи ---
# Токен Crypto Pay (@CryptoBot → Crypto Pay → Create App). Вебхук: <PUBLIC_URL>/payments/webhook/crypto_usdt
CRYPTOBOT_API_TOKEN=""
# Platega (СБП): ID мерчанта и API-ключ из кабинета Platega. Только здесь (Railway → Variables), не в код.
# Callback URL в кабинете Platega: <PUBLIC_URL>/payments/webhook/platega_sbp
PLATEGA_MERCHANT_ID=""
PLATEGA_SECRET=""
# Куда вернуть покупателя после оплаты. Пусто = https://t.me/<BOT_USERNAME>
PLATEGA_RETURN_URL=""
# ЮKassa подключит сокомандник позже.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# --- VPN-панель ---
# mock: без сервера (разработка). h1: боевая H1 Panel.
PANEL_MODE="mock"
# Адрес API из настроек панели (шестерёнка → API-доступ)
H1_PANEL_URL="http://fi3.h1cloud.net:25589/api"
# Токен из «Получить API-токен». Только здесь, никогда в код или чат.
H1_PANEL_TOKEN=""
# Какие инбаунды выдавать клиентам: теги через запятую (как в панели). Пусто = все.
H1_INBOUND_TAGS="fi-tcp"
# Или явные id из GET /api/inbounds (перекрывает теги)
H1_INBOUND_IDS=""

PORT=3000
