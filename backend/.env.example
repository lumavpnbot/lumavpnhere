# Секрет для проверки HMAC подписи initData — это и есть TELEGRAM_BOT_TOKEN,
# но держим отдельной переменной, чтобы явно видеть, где он используется.

# --- Платежи ---
CRYPTOBOT_API_TOKEN=""
# ЮKassa появится позже — сокомандник добавит свои ключи сюда,
# когда подключит эквайринг. До тех пор YooKassaProvider выключен.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# --- Панель управления серверами (3x-ui) ---
