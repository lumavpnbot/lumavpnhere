DATABASE_URL="postgresql://lynk:lynk@localhost:5432/lynk_vpn"
REDIS_URL="redis://localhost:6379"

# Публичный https-адрес бэкенда: из него строится ссылка подписки https://.../sub/<token>
PUBLIC_URL="https://api.example.com"
SUPPORT_URL="https://t.me/lynkvpnsupportbot"

TELEGRAM_BOT_TOKEN=""

# Telegram ID команды через запятую: постоянный «Премиум» без оплаты
ADMIN_TELEGRAM_IDS=""

# --- Платежи ---
CRYPTOBOT_API_TOKEN=""
# ЮKassa подключит сокомандник позже.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# --- VPN-панель ---
# mock: без сервера (разработка). h1: боевая H1 Panel.
PANEL_MODE="mock"
# Адрес API из настроек панели (шестерёнка → API-доступ)
H1_PANEL_URL="http://fi3.h1cloud.net:25589/api"
# Токен из «Получить API-токен». Только здесь, никогда в код или чат.
H1_PANEL_TOKEN=""
# Какие инбаунды выдавать клиентам: теги через запятую (как в панели). Пусто = все.
H1_INBOUND_TAGS="fi-tcp"
# Или явные id из GET /api/inbounds (перекрывает теги)
H1_INBOUND_IDS=""

PORT=3000
