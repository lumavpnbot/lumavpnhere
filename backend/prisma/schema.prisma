generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  free
  start
  pro
}

enum SubscriptionStatus {
  trial
  active
  expired
}

// 'yookassa' присутствует в enum'е заранее — провайдер будет выключен
// на уровне payments-registry, пока сокомандник не подключит эквайринг.
enum PaymentMethod {
  balance
  stars
  crypto_usdt
  crypto_ton
  yookassa_card
  yookassa_sbp
  platega_sbp
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum UserRole {
  user
  support
  admin
  owner
}

enum BalanceTxKind {
  referral
  purchase
  admin
  refund
  bonus
}

enum TicketStatus {
  open
  answered
  closed
}

enum BroadcastStatus {
  scheduled
  sending
  sent
  cancelled
}

enum PayoutStatus {
  hold
  paid
  cancelled
}

// ── ТЗ v6.3: перенос подписок ──
enum TransferStatus {
  checking // В обработке
  approved // Одобрено (авто или админом)
  rejected // Отклонено
  disputed // Спорное: ручная модерация
  need_link // Запрошена другая ссылка
}

enum TransferVerdict {
  auto_approved
  disputed
  auto_rejected
}

enum ProviderList {
  white
  gray
  black
}

// ── ТЗ v6.3: достижения ──
enum RewardKind {
  days
  discount
  device
}

// ── ТЗ v6.3: статус сервиса ──
enum IncidentSeverity {
  minor
  major
}

enum IncidentStatus {
  open
  resolved
}

model User {
  id            BigInt   @id @default(autoincrement())
  tgId          BigInt   @unique @map("tg_id")
  username      String?
  avatarUrl     String?  @map("avatar_url")
  referrerId    BigInt?  @map("referrer_id")
  referralLevel Int      @default(0) @map("referral_level") // 0 базовый,1 серебро,2 золото,3 платина
  // Секрет в публичной ссылке подписки https://<домен>/sub/<subToken>. Можно перевыпустить.
  subToken      String   @unique @default(uuid()) @map("sub_token")
  trialUsed     Boolean  @default(false) @map("trial_used")
  // Персональный код в реферальной ссылке t.me/lynkorobot?start=REF_<refCode>.
  refCode       String?  @unique @map("ref_code")
  role          UserRole @default(user)
  // Подтверждённая почта (вход без Telegram, чеки).
  email         String?  @unique
  balanceRub    Decimal  @default(0) @map("balance_rub") @db.Decimal(10, 2)
  banned        Boolean  @default(false)
  // Писал ли пользователь боту: без этого Telegram не даст отправить ему сообщение.
  botStarted    Boolean  @default(false) @map("bot_started")
  lastSeenAt    DateTime? @map("last_seen_at")
  createdAt     DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]
  payments      Payment[]
  devices       Device[]
  balanceTxs    BalanceTx[]
  tickets       SupportTicket[]
  promoUses     PromoUse[]

  referredBy      Referral? @relation("ReferredUser")
  referralsMade   Referral[] @relation("ReferrerUser")
  payoutsReceived ReferralPayout[]

  transfers    TransferRequest[]
  achievements UserAchievement[]
  rewards      UserReward[]

  @@map("users")
}

model Subscription {
  id        BigInt              @id @default(autoincrement())
  userId    BigInt              @map("user_id")
  plan      SubscriptionPlan
  status    SubscriptionStatus
  startedAt DateTime            @default(now()) @map("started_at")
  expiresAt DateTime            @map("expires_at")
  autoRenew Boolean             @default(false) @map("auto_renew")
  // Когда отправили напоминание об окончании (чтобы не слать повторно).
  remindedAt DateTime?          @map("reminded_at")
  // Откуда дни: trial | payment | gift (админ, бонусы, достижения) | transfer | admin (команда проекта).
  source    String              @default("payment")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("subscriptions")
}

model Payment {
  id           BigInt        @id @default(autoincrement())
  userId       BigInt        @map("user_id")
  orderId      String        @unique @map("order_id")
  method       PaymentMethod
  amountRub    Decimal       @map("amount_rub") @db.Decimal(10, 2)
  status       PaymentStatus @default(pending)
  planPurchased SubscriptionPlan? @map("plan_purchased")
  periodDays   Int           @default(30) @map("period_days")
  // Полная цена после промокода = amountRub (к оплате провайдером) + balanceUsedRub.
  balanceUsedRub Decimal     @default(0) @map("balance_used_rub") @db.Decimal(10, 2)
  discountRub  Decimal       @default(0) @map("discount_rub") @db.Decimal(10, 2)
  // Скидка за достижения (ТЗ 3.1) и какие разовые награды она израсходует после оплаты.
  achDiscountRub Decimal     @default(0) @map("ach_discount_rub") @db.Decimal(10, 2)
  achRewardIds Json?         @map("ach_reward_ids")
  promoCodeId  BigInt?       @map("promo_code_id")
  starsAmount  Int?          @map("stars_amount")
  externalId   String?       @map("external_id")
  autoRenew    Boolean       @default(false) @map("auto_renew")
  createdAt    DateTime      @default(now()) @map("created_at")
  paidAt       DateTime?     @map("paid_at")

  user           User             @relation(fields: [userId], references: [id])
  referralPayout ReferralPayout?
  promoCode      PromoCode?       @relation(fields: [promoCodeId], references: [id])

  @@index([userId])
  @@map("payments")
}

// Отдельный лог для всех событий платежей и аномалий — на него завязаны
// алерты админу (см. раздел 6 ТЗ).
model PaymentLog {
  id        BigInt   @id @default(autoincrement())
  orderId   String   @map("order_id")
  event     String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("payments_log")
}

model Referral {
  id           BigInt   @id @default(autoincrement())
  referrerId   BigInt   @map("referrer_id")
  referredId   BigInt   @unique @map("referred_id")
  createdAt    DateTime @default(now()) @map("created_at")
  levelAtTime  Int      @map("level_at_time")

  referrer User @relation("ReferrerUser", fields: [referrerId], references: [id])
  referred User @relation("ReferredUser", fields: [referredId], references: [id])

  @@map("referrals")
}

model ReferralPayout {
  id          BigInt       @id @default(autoincrement())
  referrerId  BigInt       @map("referrer_id")
  paymentId   BigInt       @unique @map("payment_id")
  amountRub   Decimal      @map("amount_rub") @db.Decimal(10, 2)
  status      PayoutStatus @default(hold)
  payoutAfter DateTime     @map("payout_after") // холд 7 дней
  createdAt   DateTime     @default(now()) @map("created_at")

  referrer User    @relation(fields: [referrerId], references: [id])
  payment  Payment @relation(fields: [paymentId], references: [id])

  @@map("referral_payouts")
}

// Сервер VPN-инфраструктуры. Пока сокомандник не поднял реальные VPS,
// строки сюда добавляются вручную/через мок — панель работает через
// абстракцию PanelProvider (см. src/panel).
model Server {
  id          BigInt   @id @default(autoincrement())
  location    String
  host        String
  panelUrl    String?  @map("panel_url")
  isTunnel    Boolean  @default(false) @map("is_tunnel") // промежуточный сервер (узел)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("servers")
}

model Device {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  hwid       String
  label      String?
  // ОС и версия из заголовков Happ (x-device-os, x-ver-os), приложение из user-agent.
  platform   String?
  app        String?
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, hwid])
  @@map("devices")
}

// Все движения по внутреннему балансу: начисления, списания, возвраты.
model BalanceTx {
  id        BigInt        @id @default(autoincrement())
  userId    BigInt        @map("user_id")
  amountRub Decimal       @map("amount_rub") @db.Decimal(10, 2)
  kind      BalanceTxKind
  note      String?
  paymentId BigInt?       @map("payment_id")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("balance_txs")
}

model PromoCode {
  id        BigInt    @id @default(autoincrement())
  code      String    @unique
  percent   Int
  maxUses   Int?      @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  expiresAt DateTime? @map("expires_at")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")

  uses     PromoUse[]
  payments Payment[]

  @@map("promo_codes")
}

model PromoUse {
  id        BigInt   @id @default(autoincrement())
  promoId   BigInt   @map("promo_id")
  userId    BigInt   @map("user_id")
  paymentId BigInt?  @map("payment_id")
  createdAt DateTime @default(now()) @map("created_at")

  promo PromoCode @relation(fields: [promoId], references: [id])
  user  User      @relation(fields: [userId], references: [id])

  @@unique([promoId, userId])
  @@map("promo_uses")
}

model SupportTicket {
  id           BigInt       @id @default(autoincrement())
  userId       BigInt       @map("user_id")
  subject      String
  status       TicketStatus @default(open)
  assigneeTgId BigInt?      @map("assignee_tg_id")
  firstReplyAt DateTime?    @map("first_reply_at")
  closedAt     DateTime?    @map("closed_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id])
  messages TicketMessage[]

  @@index([status])
  @@map("support_tickets")
}

model TicketMessage {
  id         BigInt   @id @default(autoincrement())
  ticketId   BigInt   @map("ticket_id")
  fromStaff  Boolean  @default(false) @map("from_staff")
  authorTgId BigInt   @map("author_tg_id")
  text       String
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("ticket_messages")
}

// Кто из команды что сделал в админ-меню.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  adminTgId  BigInt   @map("admin_tg_id")
  action     String
  target     String?
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_log")
}

// Настройки, которые меняются из админ-меню (цены, trial, проценты, тексты).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Broadcast {
  id            BigInt          @id @default(autoincrement())
  segment       String
  text          String
  buttonText    String?         @map("button_text")
  buttonUrl     String?         @map("button_url")
  scheduledAt   DateTime        @map("scheduled_at")
  status        BroadcastStatus @default(scheduled)
  delivered     Int             @default(0)
  failed        Int             @default(0)
  blocked       Int             @default(0)
  createdByTgId BigInt          @map("created_by_tg_id")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@map("broadcasts")
}

// ── ТЗ v6.3 · 01 Перенос подписок ──────────────────────────────────────────
model TransferRequest {
  id             BigInt           @id @default(autoincrement())
  userId         BigInt           @map("user_id")
  link           String
  linkHash       String           @map("link_hash") // SHA-256 нормализованной ссылки
  linkType       String           @map("link_type") // subscription | vless | vmess | trojan | ss
  provider       String? // домен провайдера (или сервера для vless/vmess/…)
  providerList   ProviderList?    @map("provider_list") // black = в чёрном списке, null = разрешён
  status         TransferStatus   @default(checking)
  verdict        TransferVerdict?
  days           Int? // рассчитанный остаток дней (до ограничения 90)
  creditedDays   Int?             @map("credited_days")
  expireAt       DateTime?        @map("expire_at")
  httpStatus     Int?             @map("http_status")
  responseMs     Int?             @map("response_ms")
  bodyBytes      Int?             @map("body_bytes")
  configsCount   Int?             @map("configs_count")
  userInfo       String?          @map("user_info") // заголовок subscription-userinfo целиком
  checks         Json             @default("[]") // 14 пунктов чек-листа
  log            Json             @default("[]") // шаги проверки для аудита и экспорта
  ip             String?
  userAgent      String?          @map("user_agent")
  accountAgeDays Int              @map("account_age_days")
  hadPaidSub     Boolean          @default(false) @map("had_paid_sub")
  rejectReason   String?          @map("reject_reason")
  decidedByTgId  BigInt?          @map("decided_by_tg_id")
  decidedAt      DateTime?        @map("decided_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user     User              @relation(fields: [userId], references: [id])
  comments TransferComment[]

  @@index([linkHash])
  @@index([userId])
  @@index([ip])
  @@index([status])
  @@index([createdAt])
  @@map("transfer_requests")
}

model TransferComment {
  id         BigInt   @id @default(autoincrement())
  transferId BigInt   @map("transfer_id")
  authorTgId BigInt   @map("author_tg_id")
  text       String
  createdAt  DateTime @default(now()) @map("created_at")

  transfer TransferRequest @relation(fields: [transferId], references: [id])

  @@index([transferId])
  @@map("transfer_comments")
}

// Белый / серый / чёрный список провайдеров.
model TransferProvider {
  id        BigInt       @id @default(autoincrement())
  domain    String       @unique
  name      String?
  list      ProviderList @default(white)
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("transfer_providers")
}

// ── ТЗ v6.3 · 03 Достижения ────────────────────────────────────────────────
model UserAchievement {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt   @map("user_id")
  code          String
  unlockedAt    DateTime @default(now()) @map("unlocked_at")
  grantedByTgId BigInt?  @map("granted_by_tg_id") // ручная выдача админом
  showcaseSlot  Int?     @map("showcase_slot") // 0..2 — закреплён в шоукейсе

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, code])
  @@index([code])
  @@map("user_achievements")
}

// Награды: дни (выдаются сразу), скидки (на следующие платежи), бонусные устройства.
model UserReward {
  id            BigInt     @id @default(autoincrement())
  userId        BigInt     @map("user_id")
  code          String? // код достижения
  kind          RewardKind
  value         Int // дни / проценты / устройства
  expiresAt     DateTime?  @map("expires_at") // скидка: до какой даты; null = бессрочно
  reusable      Boolean    @default(false) // скидка не расходуется (на год / навсегда)
  lapseWithSub  Boolean    @default(false) @map("lapse_with_sub") // устройство сгорает, если подписка закончилась
  applyNext     Boolean    @default(true) @map("apply_next") // «Применить к следующему платежу»
  usedAt        DateTime?  @map("used_at")
  usedPaymentId BigInt?    @map("used_payment_id")
  revokedAt     DateTime?  @map("revoked_at")
  createdAt     DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_rewards")
}

// ── ТЗ v6.3 · 02 Статус сервиса ────────────────────────────────────────────
model StatusCheck {
  id     BigInt   @id @default(autoincrement())
  node   String
  ok     Boolean
  pingMs Int?     @map("ping_ms")
  at     DateTime @default(now())

  @@index([node, at])
  @@index([at])
  @@map("status_checks")
}

model Incident {
  id            BigInt           @id @default(autoincrement())
  title         String
  text          String?
  severity      IncidentSeverity @default(minor)
  status        IncidentStatus   @default(open)
  node          String?
  auto          Boolean          @default(false) // открыт мониторингом, закроется сам при восстановлении
  eta           DateTime? // ожидаемое время восстановления
  startedAt     DateTime         @default(now()) @map("started_at")
  resolvedAt    DateTime?        @map("resolved_at")
  createdByTgId BigInt?          @map("created_by_tg_id")
  notifiedAll   Boolean          @default(false) @map("notified_all")

  @@index([status])
  @@index([startedAt])
  @@map("incidents")
}

// История привязок устройств (ТЗ 5.2 «Устройства»).
model DeviceEvent {
  id     BigInt   @id @default(autoincrement())
  userId BigInt   @map("user_id")
  hwid   String
  label  String?
  event  String // bound | unbound | admin_unbound
  byTgId BigInt?  @map("by_tg_id")
  at     DateTime @default(now())

  @@index([userId])
  @@map("device_events")
}

// Одноразовые коды для привязки почты. Храним только хэш кода.
model EmailCode {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  email     String
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_codes")
}
