# Домен прокси (A-запись → IP этого сервера). Без https:// и без слэша.
SUB_DOMAIN=sub.example.ru
# Бэкенд на Railway.
UPSTREAM=https://lynk-vpn-backend-production.up.railway.app
# Порты, если 80/443 на сервере заняты (например, Xray). Сертификат выпускается через порт 80,
# поэтому HTTP_PORT лучше оставить 80. Если HTTPS_PORT другой, SUB_URL пишется с ним: https://sub.example.ru:8443
HTTP_PORT=80
HTTPS_PORT=443
